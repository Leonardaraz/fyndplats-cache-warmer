  "ignoreCommand": "[ \"$VERCEL_PROJECT_ID\" = \"prj_CEca1mZt6bjVcL4FqUWxCshYUvNL\" ] && exit 0; [ -z \"$VERCEL_GIT_PREVIOUS_SHA\" ] && exit 1; git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':!docs' ':!tools' ':!*.md'"
