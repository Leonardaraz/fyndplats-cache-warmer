# --- AliExpress Drop Shipping API ---
# Hämtas från Open Platform App Console (appen du skapade).
ALIEXPRESS_APP_KEY=535350
ALIEXPRESS_APP_SECRET=
# Sätts automatiskt via /api/aliexpress/auth → /api/aliexpress/callback (OAuth-flödet).
ALIEXPRESS_ACCESS_TOKEN=
ALIEXPRESS_REFRESH_TOKEN=

# --- Supplier-watch (auto-import av nya leverantörsprodukter) ---
# Daglig cron (/api/cron/supplier-watch, 05:00 UTC): söker AliExpress på våra
# kategoritermer, filtrerar på bevakade säljar-ID + bekräftat EU-lager, dedupar
# mot FyndplatsMappings, och köar nya träffar som RAW drafts i /admin/queue.
# Kör scripts/ensure-supplier-watch-collection.mjs en gång innan första körningen.
# DRY-RUN är default PÅ — köar inget förrän du sätter "false".
SUPPLIER_WATCH_DRY_RUN=true
# Komma-separerade AliExpress store_id att bevaka. Tom = inbyggd lista (Aosom + SucceBuy).
SUPPLIER_WATCH_SELLER_IDS=
# Komma-separerade söktermer (engelska). Tom = inbyggd nisch-lista.
SUPPLIER_WATCH_TERMS=
# Rate-limit-skydd per körning.
SUPPLIER_WATCH_TERMS_PER_RUN=6
SUPPLIER_WATCH_MAX_DETAIL_CALLS=60
SUPPLIER_WATCH_MAX_IMPORTS_PER_RUN=8
SUPPLIER_WATCH_MAX_COST_USD=250
SUPPLIER_WATCH_SEEN_TTL_DAYS=45
SUPPLIER_WATCH_SEARCH_PAGE_SIZE=30

# Kandidat-källa. "keyword" (default) = text.search på kategoritermer.
# "seller" = säljar-scopad bindning (butiks-katalog per store_id). Verifiera
# först i prod med GET /api/aliexpress/seller-probe?storeId=... innan du sätter
# "seller" — kolla vilken källa som ger id.
SUPPLIER_WATCH_MODE=keyword
# Vilka seller-källor som är på (komma-sep). Default = "storefront" (äkta per-
# säljar-täckning). Lägg till "api" FÖRST när seller-probe bekräftat att AE:s
# searchExtend-säljarfilter faktiskt smalnar träffarna (annars bara bortkastade
# anrop). Ex: SUPPLIER_WATCH_SOURCES=storefront,api
SUPPLIER_WATCH_SOURCES=storefront
# Antal butiker per körning (roteras; full täckning över flera dagar). Håller
# nere AE-anrop/körning så vi inte slår i lambda-timeout/rate-limit.
SUPPLIER_WATCH_STORES_PER_RUN=4
# Storefront-URL-mall ({storeId} byts ut). Default = AE-butik sorterad på nyast.
# Peka om till ett internt JSON-endpoint om du hittar ett stabilare.
SUPPLIER_WATCH_STOREFRONT_URL_TEMPLATE=
# AE blockerar ofta datacenter-IP:n. Sätt en skrap-proxy (tar mål-URL URL-kodad
# efter sitt fäste, t.ex. https://min-proxy/?url=) så storefront-källan funkar.
SUPPLIER_WATCH_SCRAPE_PROXY_URL=
SUPPLIER_WATCH_STOREFRONT_CAP=200
SUPPLIER_WATCH_FETCH_TIMEOUT_MS=12000
SUPPLIER_WATCH_API_TERMS_PER_STORE=4

# --- Claude API (för översättning + SEO + bildanalys + auto-kategorisering) ---
ANTHROPIC_API_KEY=sk-ant-...
# Kill-switches om Claude beter sig konstigt eller blir för dyrt.
# Default = "on". Sätt "off" för att stänga av respektive funktion.
CLAUDE_IMAGE_ANALYSIS=on
CLAUDE_AUTO_CATEGORIZATION=on
# Variantöversättning: AI-fallback (Haiku) för variantvärden som den statiska
# tabellen missar. Default på, FRIKOPPLAD från AI_ENRICHMENT_ENABLED (tabell +
# per-värde-cache först → nära $0). Sätt "false" för hård $0 på varianter
# (svansen lämnas då engelsk och produkten flaggas för polering).
VARIANT_AI_TRANSLATION_ENABLED=true
# Modellnamn (overrideas vid behov; default är claude-sonnet-4-5 med vision).
# CLAUDE_VISION_MODEL=claude-sonnet-4-5
# CLAUDE_TEXT_MODEL=claude-sonnet-4-5

# --- Kostnadsoptimerad import-pipeline (2026-06-01) ---
# Batchat textflöde: slår ihop SEO + kategori + flikar till ETT Claude-anrop
# (default på). Sätt "false" för att falla tillbaka på de tre separata anropen.
USE_BATCHED_PIPELINE=true
# Modell för det sammanslagna anropet. Default = CLAUDE_TEXT_MODEL (Haiku 4.5).
# Höj till claude-sonnet-4-6 om SEO-kvaliteten behöver mer (A/B-grindens utväg).
# CLAUDE_BATCH_MODEL=claude-haiku-4-5-20251001
# Anthropic Batch API (50 % rabatt) — MASTER-switch för smart routing
# (lib/import/trigger-routing.ts). PÅ → bakgrundskällor (bulk-CSV / cron /
# admin-batch) routas via Batch API; UX-blockerande källor (extension,
# admin-singel) körs ALLTID realtid oavsett denna flagga. Default av i exempel,
# men satt till "true" i Vercel-produktion (latens-toleranta bulk-jobb).
USE_BATCH_API=false

# --- Recensioner ---
# Ingen översättningstjänst. DeepL togs bort 2026-08-19 — importerade recensioner
# sparas som `pending` med originaltexten och skrivs om till svenska för hand i
# /admin/reviews. DEEPL_API_KEY och DEEPL_MONTHLY_BUDGET läses inte av någon kod
# längre och kan tas bort ur Vercel.
# Killswitch för recensions-visning (sätts på HEADLESS): "initials" (default) →
# "M.K."; "verified_buyer" → "Verifierad köpare" (panic-läge, en flagga, ingen migration).
# REVIEW_DISPLAY_MODE=initials

# --- Wix Stores (headless / REST) ---
# OAuth-token med Stores-scope (Product write i V3-katalogen).
WIX_API_TOKEN=
# Site-ID för fyndplats-butiken.
WIX_SITE_ID=
# Recensions-kollektion (skapas via scripts/ensure-reviews-collection.mjs).
WIX_DATA_COL_REVIEWS=FyndplatsImportedReviews

# --- Migration (Fyndplats v1 -> ny headless v3) ---
# Källa: Fyndplats (V1_CATALOG). Default är hårdkodat i orkestratorn.
SOURCE_SITE_ID=8c62127f-c07a-4596-86b8-4e88b5cc502d
# Mål: nya headless-sajten (kräver V3_CATALOG = Wix Stores installerat).
TARGET_SITE_ID=
# Säkerhetsspärr för skarp körning (migrate:run kräver detta = 1).
MIGRATION_CONFIRM=
# Publik nyckel (PEM) för att verifiera Wix order-webhooks (RS256-JWT).
# Hämtas från Wix Dev Center. Utan den avvisas inkommande webhooks.
WIX_WEBHOOK_PUBLIC_KEY=

# --- Skydd av interna endpoints ---
# Delad hemlig token som browser-tillägget skickar i x-fyndplats-token-headern.
# Generera en lång slumpsträng, lägg samma värde i tilläggets konfig.
EXTENSION_API_TOKEN=

# --- Prissättning ---
# Svensk moms i procent (25 = 25%).
VAT_RATE_PERCENT=25
# IOSS-tröskel i EUR (försändelser över detta kräver vanlig importdeklaration).
IOSS_THRESHOLD_EUR=150
# Manuell valutakurs tills en FX-källa beslutats (1 USD -> SEK).
USD_TO_SEK=10.5

# --- Lagring ---
# "memory" (default, in-memory, försvinner vid omstart — bra för dev/test) eller
# "wix-data" (persistent i Wix Data-collections — krävs för skarp drift).
STORE_BACKEND=memory
# Namn på Wix Data-collections (skapa dem i Wix Data-CMS innan första körningen):
WIX_DATA_COL_MAPPINGS=FyndplatsMappings
WIX_DATA_COL_EVENTS=FyndplatsWebhookEvents
WIX_DATA_COL_TASKS=FyndplatsTasks
WIX_DATA_COL_AUDIT=FyndplatsAudit
# /admin/profitability skriver hit vid varje import (best-effort).
# Skapa kollektionen i Wix Data CMS innan första körningen — fält: productId
# (Text, key), costSek (Number), costUsd (Number, optional), currency (Text),
# importedAt (Date), source (Text), note (Text, optional).
WIX_DATA_COL_IMPORT_COSTS=FyndplatsImportCosts

# --- Klarna-avgift (för lönsamhetsöversikten) ---
KLARNA_FEE_PERCENT=3
KLARNA_FEE_FIXED_SEK=2

# --- Lönsamhetsdashboard (/admin/profitability) ---
# Fast fraktestimat i SEK per såld enhet (default 15).
SHIPPING_COST_ESTIMATE_SEK=15
# Antagen inköp som fraktion av netto-sälj när faktisk inköpsdata saknas
# (default 0.30 = 30%). Endast fallback — exakt data från import används när
# den finns.
FALLBACK_COST_FRACTION_OF_NET=0.3
# Site-ID för headless V3-katalogen (där produkter + orders lever).
# Default är hardcodad i koden — sätts här bara för override.
# HEADLESS_WIX_SITE_ID=e6d27e90-4749-4720-9afe-0bbe91c1b3d3

# --- Hybrid slut-i-lager + alternativ + prioriterad sync ---
# (Features: hybrid OOS, real-tids-larm, alternativa leverantörer, priority sync)
#
# Wix Data-kollektion för restock-bevakare (skapas av scripts/ensure-restock-collection.mjs).
WIX_DATA_COL_RESTOCK=FyndplatsRestockSubscribers
# Wix Data-kollektion för 30-dagars alternativ-cache (Feature 3 kostnadsopt.).
WIX_DATA_COL_ALT_CACHE=FyndplatsAlternativeCache
# Alternativa-leverantörs-sökning i OOS-mejlet. off = stäng av.
# PRIMÄR sökväg är gratis (deterministisk EU-först-rankning + 30-dgr-cache);
# Claude Haiku används BARA som fallback (<3 träffar / blandad kategori),
# budget-capad av ANTHROPIC_DAILY_BUDGET_USD.
OOS_ALTERNATIVES=on
# Prioriterad sync: bestseller-prioritet + köp-triggad high-priority. off = av.
PRIORITY_SYNC=on
# Bas-URL för produktsidan på storefronten (restock-mejlets "Visa produkten").
STORE_PRODUCT_BASE_URL=https://fyndplats.se/produkt
# Fallback-URL om produkten saknar slug.
NEXT_PUBLIC_STORE_URL=https://fyndplats.se
# Extra CORS-origins (kommaseparerat) för /api/restock-subscribe, t.ex.
# headless preview-deployer. www.fyndplats.se + *.vercel.app är redan tillåtna.
# STOREFRONT_ORIGINS=https://preview.fyndplats.se
# OPS_ALERT_EMAIL återanvänds som mottagare för real-tids-OOS-larmen.

# --- Testläge ---
# Sätt till 1 för att köra utan att skriva mot Wix (säker testning mot ej-live).
DRY_RUN=0

# --- Hälsokoll (api/cron/health-check, var 5:e min) ---
# Mottagare för 🔴 Wix-nere-/✅ friskt-igen-larmen. Default: info@fyndplats.com.
HEALTH_ALERT_EMAIL=

# --- AliExpress-synken (api/cron/aliexpress-sync, var 4:e timme) ---
# DEN VIKTIGASTE SWITCHEN I HELA REPOT. Default är "true", och allt som INTE är
# exakt strängen "false" gör körningen SKRIVFRI: inga Wix-lagerskrivningar,
# fraktbarhetskontrollen hoppas över — och strike-fälten FRYSES, så en nedtagen
# eller slutsåld produkt kan aldrig nå strike 2 och förblir köpbar för kund.
# Ett tyst dry-run ger exakt samma symtom över hela katalogen. Morgonmejlet
# säger nu ifrån när körningarna var torra.
SYNC_DRY_RUN=false
# Produkter (inte anrop — räknaren ökar en gång per produkt) per körning.
# 100 × 6 körningar ≈ 1,5 dygns rotation på ~876 mappningar. Höj först när
# summeringens `boundBy` visar "calls" och inte "clock".
SYNC_MAX_API_CALLS=100
# Fraktbarhetskontroller per körning. 0 pausar. Se kod röd 2026-07-14.
SYNC_SHIPPABILITY_CHECKS_PER_RUN=20
# Gatar BARA gamla v1-flaggor utan bevisserie (~13 varianter från kod röd).
# Bevisade v2-domar och manuella verdikt nollar lager oavsett den här.
SYNC_SHIPPABILITY_ENFORCE=false
# Marginalgolv i procent för prislarm.
SYNC_MARGIN_FLOOR_PERCENT=20
