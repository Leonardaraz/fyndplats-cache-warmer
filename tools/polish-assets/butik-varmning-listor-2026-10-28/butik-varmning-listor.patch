 }
+
+// ── Listorna efter produkterna ────────────────────────────────────────────
+//
+// ☠️ DET LED SOM GÖR KATALOGEN KLAR HANN INTE MED LISTORNA (2026-10-24).
+// Produktlistorna bakom "Visa fler", filter och sortering (app/api/lista, en per
+// kategori plus alla och rea) värms av det led som värmer sista produkterna, och
+// de delar ledets deadline. Efter butiksdeployen 00:33 UTC värmde led 2 sina
+// 1 796 sista produkter på hela sina 200 s och loggade sedan
+// `Listor: 0/133 (avbruten på deadline)`: kedjan värmde ingen av de 133.
+// Huvudlistorna blev varma av nästa kvartskörning (de värms i varje körning),
+// men de ungefär 120 underkategorilistorna stod kalla tills någon bad om dem.
+// Listsidornas egen HTML var varm ändå, 18 av 21 var förbyggda av deployen.
+//
+// Ett avbrutet listpass lämnar därför resten till ett nytt led, på samma sätt
+// som ett avbrutet produktpass, med platsen i listornas ordning i kroppen. Ledet
+// räknar om nycklarna ur kategorierna och fortsätter där det förra slutade.
+
+/** Hur det gick att starta nästa led i en värmning. Typen bor här, inte i
+ *  warm.ts, så att överlämningen nedan kan provas utan den modulen. */
+export type LedStart = "startat" | "sista-ledet" | "inte-produktion" | "ingen-hemlighet" | "nekat" | "fel";
+
+export type ListPass = { ok: number; fel: number; avbruten: boolean };
+
+/** Var nästa listled ska börja: allt före `fran + ok + fel` är hämtat. Fel
+ *  räknas som hämtade, de görs inte om (som kvarEfterPass för produkterna). */
+export function listorEfterPass(fran: number, pass: { ok: number; fel: number }): number {
+  return fran + Math.max(0, pass.ok + pass.fel);
+}
+
+/**
+ * Värm listorna från plats `fran`, och lämna det som inte hann till ett nytt led
+ * (nummer `nastaLed`). `varm` och `starta` är injicerade: warm.ts skickar in
+ * varmListor och startaListled, och testet skickar in låtsasversioner.
+ *
+ * Ett pass som hann klart startar ingenting. `nasta` är null då, annars hur det
+ * gick att starta ledet, så att anroparen kan logga ett led som inte startade.
+ */
+export async function varmListorMedOverlamning<K>(
+  alla: readonly K[],
+  fran: number,
+  nastaLed: number,
+  varm: (nycklar: readonly K[]) => Promise<ListPass>,
+  starta: (fran: number, led: number) => Promise<LedStart>,
+): Promise<{ pass: ListPass; av: number; kvar: number; nasta: LedStart | null }> {
+  const att = alla.slice(fran);
+  const pass = await varm(att);
+  if (!pass.avbruten) return { pass, av: att.length, kvar: 0, nasta: null };
+  const kvar = Math.max(0, att.length - pass.ok - pass.fel);
+  const nasta = await starta(listorEfterPass(fran, pass), nastaLed);
+  return { pass, av: att.length, kvar, nasta };
+}
