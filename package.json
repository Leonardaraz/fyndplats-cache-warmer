{
  "name": "fyndplats-dropship",
  "version": "0.1.0",
  "private": true,
  "description": "Headless import/sync/fulfillment-verktyg för Fyndplats (Wix Stores + AliExpress dropshipping)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:dry": "node --experimental-strip-types --no-warnings=ExperimentalWarning migration/scripts/dry-run.ts",
    "migrate:dry-live": "node --experimental-strip-types --no-warnings=ExperimentalWarning migration/scripts/orchestrator.ts --dry-run",
    "migrate:run": "node --experimental-strip-types --no-warnings=ExperimentalWarning migration/scripts/orchestrator.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
